<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Embedded into the binary (__TEXT,__info_plist). PencilKit stores per-app state under the
     bundle identifier and crashes in a process without one. -->
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>dev.nnote.cli</string>
    <key>CFBundleName</key>
    <string>nnote</string>
</dict>
</plist>
